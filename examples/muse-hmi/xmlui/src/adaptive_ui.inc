// App methods: one context revision binds every adaptive panel and report.
 J refreshAdaptive(bool report=false){
  auto context=adaptive.context(location);auto revision=adaptive.revision();
  QString message="Update Winuvo Adaptive Living for the CURRENT configured ZIP. Read adaptive.context first. If location_resolved is false, resolve the ZIP to its time zone and call adaptive.configure with the SAME postal_code and its IANA time_zone (refresh=false). Retrieve current sourced weather, outdoor air quality and news feeds. Respect local time/date/season/daylight. Climate adapts to weather; lighting AND energy adapt to time/date/season/weather. Air suggests purifier on/off/hold, without claiming a connected purifier. Security reflects motion, person detection, enrolled face IDs, cameras and doors only when real feeds exist; otherwise Awaiting feeds. Sound is adaptive home-theater tuning; preserve EQ, volume and the real listening session. Scenes combine the recommendations. Home remixes all panels and media. Use adaptive.publish with postal_code and revision from the CURRENT adaptive.context, normalized inputs and panels for all ten templates (home,weather,news,air,climate,lighting,energy,security,sound,scenes). No SAMPLE facts. Each input has data, basis measured/model/feed, HTTPS source, timestamp with offset. Data keys: weather temperature_c,humidity_percent,condition,sunrise,sunset; air_quality aqi,pm2_5; news stories [{title,url,published}]. Label CAMS as a model estimate. Keep hero<=35 chars, summary<=100, source concise but dated, short metrics and honest unknown states. Do not call adaptive.refresh recursively or change media/audio/devices. ";
  if(report)message+="After publishing, call adaptive.report to generate today's picture PDF on board. Summarize the report in our paired phone chat. If file tools are available, read adaptive.report.read chunks and attach the PDF; never claim attachment delivery without producing it. ";
  message+="Current context: "+str(context);ask(message);return {{"submitted",true},{"postal_code",location["postal_code"]},{"revision",revision},{"daily_report_requested",report}};
 }
 J dailyReport(){
  auto context=adaptive.context(location);auto date=context["calendar"]["date"].get<std::string>();auto code=location["postal_code"].get<std::string>();QString directory=folder+"/reports";QDir().mkpath(directory);QString name=QString::fromStdString("winuvo-"+date+"-"+code+".pdf"),path=directory+"/"+name;
  auto oldCurrent=current;auto oldData=data;bool oldExport=exportOnly;exportOnly=true;
  try{
   QPdfWriter writer(path);writer.setResolution(96);writer.setPageSize(QPageSize(QPageSize::A4));writer.setPageMargins(QMarginsF(0,0,0,0));writer.setTitle("Winuvo Adaptive Living / Daily picture briefing");writer.setCreator("Winuvo on MA35H0");QPainter painter(&writer);if(!painter.isActive())throw std::runtime_error("PDF writer unavailable");
   auto heading=[&]{painter.fillRect(QRect(0,0,794,1123),QColor("#0c102b"));painter.setPen(QColor("#f3f6ff"));painter.setFont(QFont("DejaVu Sans",20,QFont::Bold));painter.drawText(35,55,"Winuvo Adaptive Living");painter.setFont(QFont("DejaVu Sans",11));painter.setPen(QColor("#a7b8dd"));painter.drawText(35,84,QString::fromStdString(date+" / ZIP "+code+" / "+context["calendar"]["time_zone"].get<std::string>()));painter.drawText(35,106,"Daily picture briefing / sources and estimates labelled on each panel");};
   const QStringList ids={"home","weather","air","news","climate","lighting","energy","security","sound","scenes"};int index=0;
   for(const auto& id:ids){if(index%2==0){if(index&&!writer.newPage())throw std::runtime_error("Cannot write report page");heading();}auto values=saved.value(id,J::object());show(id,values);auto thumbnail=composed.scaled(640,375,Qt::IgnoreAspectRatio,Qt::SmoothTransformation);int y=index%2?634:166;painter.setPen(QColor("#66e3cf"));painter.setFont(QFont("DejaVu Sans",12,QFont::Bold));painter.drawText(35,y-15,catalog.screens[id].title);painter.drawImage(QRect(35,y,724,424),thumbnail);++index;}
   painter.end();show(oldCurrent,oldData);exportOnly=oldExport;draw();QFile file(path);if(file.size()<1000)throw std::runtime_error("Report PDF is empty");return {{"file",name.toStdString()},{"path",path.toStdString()},{"bytes",file.size()},{"pages",5},{"pictures",10},{"postal_code",code},{"context_revision",adaptive.revision()},{"created_at",QDateTime::currentDateTimeUtc().toString(Qt::ISODate).toStdString()},{"phone_attachment","Use report.read chunks with the paired phone file tools; delivery is not implied"}};
  }catch(...){try{show(oldCurrent,oldData);}catch(...){}exportOnly=oldExport;throw;}
 }
 J adaptiveCommand(const std::string& action,const J& p){
  if(action=="adaptive.context")return adaptive.context(location);
  if(action=="adaptive.evaluate")return adaptive.evaluate(location);
  if(action=="adaptive.configure"){
   auto code=p.value("postal_code",location["postal_code"].get<std::string>());if(code.size()!=5||!std::all_of(code.begin(),code.end(),[](char c){return c>='0'&&c<='9';}))throw std::runtime_error("A five-digit US ZIP is required");if(p.contains("time_zone")&&!QTimeZone(QByteArray::fromStdString(p["time_zone"].get<std::string>())).isValid())throw std::runtime_error("Valid IANA time zone required");bool changed=code!=location["postal_code"].get<std::string>();
   if(changed){adaptive.invalidateLocation(p.contains("time_zone"));setLocation({{"country","US"},{"postal_code",code}},true);saved.clear();auto previous=exportOnly;exportOnly=true;for(const auto& screen:catalog.screens){J pending={{"hero","Adapting to ZIP "+code},{"summary","Muse is refreshing local context and dependent panels."},{"metric1_label","Location"},{"metric1",code},{"metric2_label","Context"},{"metric2","Updating"},{"metric3_label","Sources"},{"metric3","Pending"},{"source","Location changed / awaiting fresh context"}};saved[screen.id]=catalog.bind(screen.id,pending);}show("home",saved["home"]);exportOnly=previous;draw();}
   J config=J::object();for(const char* key:{"time_zone","purifier"})if(p.contains(key))config[key]=p[key];if(!config.empty())adaptive.configure(config);
   auto result=adaptive.context(location);if(p.value("refresh",changed))result["refresh"]=refreshAdaptive(p.value("report",false));return result;
  }
  if(action=="adaptive.update"||action=="adaptive.publish"){
   if(p.at("revision").get<int>()!=adaptive.revision()||p.at("postal_code")!=location["postal_code"])throw std::runtime_error("Location context changed; discard stale publication and read adaptive.context again");
   QMap<QString,J> next;if(p.contains("panels")){if(!p["panels"].is_object()||p["panels"].size()>10)throw std::runtime_error("At most ten named panels required");for(auto item=p["panels"].begin();item!=p["panels"].end();++item){auto id=QString::fromStdString(item.key());next[id]=catalog.bind(id,item.value());}}
   if(p.contains("inputs")){adaptive.update(p["inputs"]);}
   for(auto it=next.begin();it!=next.end();++it){saved[it.key()]=it.value();}
   if(!next.empty())show(saved.contains("home")?"home":current,saved.value(saved.contains("home")?"home":current,data));return {{"published",true},{"revision",adaptive.revision()},{"postal_code",location["postal_code"]},{"panels_updated",next.size()}};
  }
  if(action=="adaptive.refresh")return refreshAdaptive(p.value("report",false));
  if(action=="adaptive.report")return dailyReport();
  if(action=="adaptive.reports"){J out=J::array();for(auto name:QDir(folder+"/reports").entryList({"*.pdf"},QDir::Files,QDir::Name))out.push_back({{"file",name.toStdString()},{"bytes",QFile(folder+"/reports/"+name).size()}});return out;}
  if(action=="adaptive.report.read"){auto name=str(p.at("file"));if(name.contains('/')||name.contains('\\')||name.contains("..")||!name.endsWith(".pdf"))throw std::runtime_error("Report basename required");QFile file(folder+"/reports/"+name);if(!file.open(QIODevice::ReadOnly))throw std::runtime_error("Report unavailable");auto offset=p.value("offset",int64_t(0));if(offset<0||offset>file.size()||!file.seek(offset))throw std::runtime_error("Invalid report offset");auto chunk=file.read(32768);return {{"file",name.toStdString()},{"offset",offset},{"next_offset",offset+chunk.size()},{"total_bytes",file.size()},{"eof",offset+chunk.size()>=file.size()},{"base64",chunk.toBase64().toStdString()}};}
  throw std::runtime_error("Unknown adaptive action");
 }
