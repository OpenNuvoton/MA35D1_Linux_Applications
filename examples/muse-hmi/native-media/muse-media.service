[Unit]
Description=Muse board-native media API and renderer
After=network.target mnt-sd.mount
Requires=mnt-sd.mount

[Service]
ExecStart=/mnt/sd/muse/media/muse-media
Environment=MUSE_MEDIA_BASE=/mnt/sd/muse/media/
Environment=MUSE_MEDIA_CACHE_DIR=/mnt/sd/muse/media-cache
Restart=on-failure
RestartSec=2
KillMode=control-group
UMask=0077
LimitCORE=0
MemoryMax=38M
TasksMax=48
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
